{
  "name": "@muffin/atom-websdk",
  "version": "3.4.1",
  "description": "WebSocket SDK layer for the Muffin framework.",
  "main": "src/main.js",
  "module": "dist/sdk.esm.js",
  "browser": "dist/sdk.min.js",
  "exports": {
    ".": {
      "import": "./src/main.js",
      "browser": "./dist/sdk.min.js"
    },
    "./core": {
      "import": {
        "types": "./src/core.d.ts",
        "default": "./src/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "core",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production rollup -c && cp src/core.d.ts dist/core.d.cts",
    "build:dev": "rollup -c && cp src/core.d.ts dist/core.d.cts",
    "test": "node --test test/"
  },
  "author": "footloose.io",
  "license": "Copyright © Footloose Labs INC.",
  "peerDependencies": {
    "@muffin/element": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@muffin/element": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  }
}
